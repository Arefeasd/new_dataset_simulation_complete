```{r}
missing_summary <- df_patient |>
  summarise(
    across(
      all_of(myVars),
      list(
        missing_n = ~ sum(is.na(.)),
        missing_percent = ~ round(mean(is.na(.)) * 100, 2)
      )
    )
  ) |>
  tidyr::pivot_longer(
    cols = everything(),
    names_to = c("variable", ".value"),
    names_pattern = "^(.*)_(missing_n|missing_percent)$"
  ) |>
  mutate(
    total_n = nrow(df_patient),
    available_n = total_n - missing_n
  ) |>
  select(
    variable,
    total_n,
    available_n,
    missing_n,
    missing_percent
  ) |>
  arrange(desc(missing_percent))

print(missing_summary, n = Inf)
```

