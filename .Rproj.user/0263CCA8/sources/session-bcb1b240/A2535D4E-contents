```{r, echo=FALSE}
# Extract results from the adjusted Cox model
cox_sum_adjusted <- summary(cox_adjusted)

forest_adjusted <- data.frame(
  Variable = rownames(cox_sum_adjusted$coefficients),
  HR = cox_sum_adjusted$conf.int[, "exp(coef)"],
  lower_CI = cox_sum_adjusted$conf.int[, "lower .95"],
  upper_CI = cox_sum_adjusted$conf.int[, "upper .95"],
  p_value = cox_sum_adjusted$coefficients[, "Pr(>|z|)"]
)

# Format the numbers
forest_adjusted$HR_txt <- sprintf("%.2f", forest_adjusted$HR)

forest_adjusted$CI_txt <- sprintf(
  "(%.2f–%.2f)",
  forest_adjusted$lower_CI,
  forest_adjusted$upper_CI
)

forest_adjusted$p_txt <- ifelse(
  forest_adjusted$p_value < 0.001,
  "<0.001",
  sprintf("%.3f", forest_adjusted$p_value)
)

# Sort variables from largest HR to smallest HR
forest_adjusted <- forest_adjusted[
  order(forest_adjusted$HR, decreasing = TRUE),
]

# Preserve order in the plot
forest_adjusted$Variable <- factor(
  forest_adjusted$Variable,
  levels = rev(forest_adjusted$Variable)
)

# Number of rows
n_rows <- nrow(forest_adjusted)

# Forest plot
ggplot(
  forest_adjusted,
  aes(
    x = HR,
    y = Variable
  )
) +

  geom_point(
    size = 2.5
  ) +

  geom_errorbarh(
    aes(
      xmin = lower_CI,
      xmax = upper_CI
    ),
    height = 0.20
  ) +

  # Reference line HR = 1
  geom_vline(
    xintercept = 1,
    linetype = "dashed"
  ) +

  # HR column
  geom_text(
    aes(
      x = 1.65,
      label = HR_txt
    ),
    hjust = 0,
    size = 4
  ) +

  # 95% CI column
  geom_text(
    aes(
      x = 2.60,
      label = CI_txt
    ),
    hjust = 0,
    size = 4
  ) +

  # p-value column
  geom_text(
    aes(
      x = 6.50,
      label = p_txt
    ),
    hjust = 0,
    size = 4
  ) +

  # Column headers
  annotate(
    "text",
    x = 1.65,
    y = n_rows + 0.8,
    label = "HR",
    hjust = 0,
    fontface = "bold",
    size = 4.5
  ) +

  annotate(
    "text",
    x = 2.60,
    y = n_rows + 0.8,
    label = "95% CI",
    hjust = 0,
    fontface = "bold",
    size = 4.5
  ) +

  annotate(
    "text",
    x = 6.50,
    y = n_rows + 0.8,
    label = "p-value",
    hjust = 0,
    fontface = "bold",
    size = 4.5
  ) +

  scale_x_log10(
    limits = c(0.45, 10),
    breaks = c(0.5, 1, 2)
  ) +

  labs(
    title = "Adjusted Cox proportional hazards model",
    x = "Hazard Ratio",
    y = NULL
  ) +

  theme_minimal(
    base_size = 12
  ) +

  theme(
    plot.margin = margin(
      t = 10,
      r = 30,
      b = 10,
      l = 10
    )
  ) +

  coord_cartesian(
    clip = "off"
  )
```

